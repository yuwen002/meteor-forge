# meteor-forge CLI 配置样例：复制为 meteor-forge.yaml 后按需修改。
# 配置优先级（viper）：显式命令行参数 > 环境变量（METEOR_DSN/METEOR_DIR/METEOR_TABLE）> 本文件 > 内置默认值。
# 所有字段均可省略；除 yaml 外也支持 meteor-forge.json / meteor-forge.toml，路径可用 --config 显式指定。
#
# 注意：DSN 中的 multiStatements=true 允许迁移脚本包含多条语句，
# parseTime=true 用于正确读取 applied_at 时间列（均为必配参数）。
dsn: "root:password@tcp(127.0.0.1:3306)/my_db?charset=utf8mb4&parseTime=true&multiStatements=true"
dir: "./migrations"
table: "schema_migrations"

# 多租户批量并发升级配置（tenants-up 命令使用；dir/table 沿用上方全局设置）
tenants:
  - name: "tenant_alpha"
    dsn: "root:password@tcp(127.0.0.1:3306)/db_tenant_alpha?charset=utf8mb4&parseTime=true&multiStatements=true"
  - name: "tenant_beta"
    dsn: "root:password@tcp(127.0.0.1:3306)/db_tenant_beta?charset=utf8mb4&parseTime=true&multiStatements=true"
